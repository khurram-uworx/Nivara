<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>

  <!-- Phase 4a (issue #431): first GPU-backend package in the probe. ILGPU is a pure-C#
       JIT kernel runtime (NCSA license, no native deps) running C# kernels as OpenCL C on
       the iGPU's in-box OpenCL ICD + Intel driver; ILGPU.Algorithms supplies XMath.Exp for
       the silu kernel (core IntrinsicMath has no exp). Snapshot pin — see docs/ILGPU.md. -->
  <ItemGroup>
    <PackageReference Include="ILGPU" Version="1.5.3" />
    <PackageReference Include="ILGPU.Algorithms" Version="1.5.3" />
  </ItemGroup>

  <!-- Phase 4b (issue #432): second GPU-backend package in the probe. ComputeSharp is a
       pure-managed C# kernel JIT (MIT) that source-generates HLSL, compiles it to DXIL
       in-process via the DXC binaries bundled by ComputeSharp.Dxc (no external compiler or
       toolchain), and dispatches it on the iGPU through D3D12 — the managed-DX12 story the
       probe's hand-rolled D3d12Compute leg predicts. Requires AllowUnsafeBlocks for the
       shader source generators. Snapshot pin — see docs/COMPUTESHARP.md. -->
  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="ComputeSharp.Dxc" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Nivara.Samples\Nivara.Samples.csproj" />
    <ProjectReference Include="..\..\src\Nivara\Nivara.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.1.26425.128" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Nivara</PackageId>
    <PackageVersion>1.3.0</PackageVersion>
    <Description>High-performance columnar DataFrame library for .NET</Description>
    <PackageReleaseNotes>v1.3.0: Typed LINQ object model (frame.Query&lt;T&gt;() with Where/Select/OrderBy/GroupBy) and typed NivaraRow frame filtering; window-function expressions in the expression DSL plus rolling/cumulative/shift/lead and the rank family (row_number/rank/dense_rank/percent_rank) across column/frame/query layers; row-wise frame scoring (RowDot/RowCosineSimilarity); NivaraSeries Sum/Min/Max aggregates restored with a virtual positional index; extended-domain numerics (char, Half, nint/nuint, Int128/UInt128, decimal) through column arithmetic, group-by Sum/Mean, series Average, Normalize/Standardize, and dynamic column creation (ColumnFactory); mixed-type operand promotion to C# binary-numeric-promotion types with modulo support; Loss&lt;T&gt;/Reduction API (default Mean) and settable Optimizer.LearningRate with functional AdamUpdate/AdamWUpdate; dim-aware Softmax/LogSoftmax, ToHalf and Half SIMD fast paths, CanBackward overload, Weight/Bias unified as Parameter&lt;T&gt;?; metadata-aware Schema/ColumnMetadata equality; immutable Json/Csv/ParquetWrite options with With() builders; XML doc comments across the AutoDiff public API; breaking changes: NivaraColumn&lt;T&gt;.CreateFromNullable(Array) removed, NivaraSeries object indexer removed (this[string] added), Module&lt;T&gt;.Forward(input1, input2) removed (IMultipleInputModule&lt;T&gt;), legacy ExpressionEvaluator and dynamic frame Where removed, loss reduction defaults to Mean. Core columnar engine unchanged: LINQ-like query engine, tensor-accelerated arithmetic and comparisons, lazy/eager/streaming/parallel execution strategies, explicit null mask semantics, schema-aware query planning with predicate pushdown and operation fusion, performance diagnostics, buffer pooling.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Extensions</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.PerformanceTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

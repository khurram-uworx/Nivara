<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Nivara</PackageId>
    <PackageVersion>1.2.0</PackageVersion>
    <Description>High-performance columnar DataFrame library for .NET</Description>
    <PackageReleaseNotes>v1.2.0: Storage consolidation onto a single ColumnStorage&lt;T&gt; (sole-owner T[] + optional bool[] null mask; zero-copy slices; lazy zero-copy AsTensorView for unmanaged types); AutoDiff GradKernels span-kernel layer with inference-only fast paths (Gelu, GeluExact, LayerNorm, Linear transposed-weight cache); new ops AddBias, MatMulTransposedB, GeluExact, BatchedMultiHeadAttention (fused [B,L,D] batch attention); ADR-001 non-nullable AutoDiff domain enforced at runtime with zero-copy enter path; Optimizer StateDict/LoadStateDict and optimizer state in checkpoints; epoch-aware DataLoader.GetBatches; OrderBy/ThenBy computed sort keys; public AsTensorView (#107); NivaraEmbeddingGenerator in Nivara.Extensions; TextClassifierModel/TokenClassifierModel moved to samples; ArrowConversionOptions.UseZeroCopy removed. Core columnar engine unchanged: LINQ-like query engine, tensor-accelerated arithmetic and comparisons, lazy/eager/streaming/parallel execution strategies, explicit null mask semantics, schema-aware query planning with predicate pushdown and operation fusion, performance diagnostics, buffer pooling.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Extensions</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.301" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

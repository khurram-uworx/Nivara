<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Nivara</PackageId>
    <PackageVersion>1.5.1</PackageVersion>
    <Description>High-performance columnar DataFrame library for .NET</Description>
    <PackageReleaseNotes>v1.5.1: Resource-management and OpenBLAS improvements — removed the internal abandoned-resource tracking subsystem in favour of explicit Dispose/Release, source-disposal failures now propagate from QueryFrame/ParquetLazySource, OpenBLAS registration honours an explicit path and surfaces real failure diagnostics, and added differentiable Laya choice logits plus the --rag-adaptive-eval loop. See CHANGELOG.md for the full list.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
    <!-- NU5104: this stable package transitively depends on prerelease packages
         (Parquet.Net 6.1.1-pre.1 and the .NET 11 RC dependency set). Suppressed so
         `dotnet pack` succeeds; revert once those dependencies ship stable. See ADR-003-style note. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Extensions</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.PerformanceTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

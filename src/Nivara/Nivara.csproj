<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Nivara</PackageId>
    <PackageVersion>1.5.0</PackageVersion>
    <Description>High-performance columnar DataFrame library for .NET</Description>
    <PackageReleaseNotes>v1.5.0: Promoted Silk (OpenCL) backend and BERT-family model layer into Nivara.Extensions; added embeddings frame convention and Microsoft.Extensions.AI glue (NivaraEmbeddingExtensions); real opt-in zero-copy Arrow export for flat primitive columns with validity-bitmap rebuild for null-bearing columns; mask-based nullable column storage (ElementType is now the underlying type); reachable streaming memory budget via AsStream(NivaraExecutionContext); modernbert benchmark selectable lengths/pass counts; qwen distillation on Silk and fused per-token decoder with batched prefill; seedable AutoDiff initializers and constructor-level initializer overrides across conv/VAE/linear modules; documentation citation and snippet gates plus ADR index gate. Core columnar engine unchanged: LINQ-like query engine, tensor-accelerated kernels, lazy/eager/streaming/parallel execution, explicit null masks. Full changelog in CHANGELOG.md.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Extensions</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.PerformanceTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

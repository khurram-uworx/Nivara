<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU5104</WarningsNotAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Nivara.Extensions</PackageId>
    <PackageVersion>1.5.0</PackageVersion>
    <Description>I/O adapters, Parquet, Apache Arrow, ML.NET, the BERT-family model layer, and the Silk OpenCL GPU backend for Nivara</Description>
    <PackageReleaseNotes>v1.5.0: Promoted Silk (OpenCL) backend and BERT-family model layer (BertModel, ModernBertModel, LayaHeadModel, tokenizers, loaders, GPU seam) into Nivara.Extensions (namespace Nivara.Silk / Nivara.AI); added NivaraEmbeddingExtensions for the float[] / E0..En frame convention and Microsoft.Extensions.AI conversion; real opt-in zero-copy Arrow export; mask-based nullable column storage handling; Streamix backpressure and pivot advances. Existing surface: Parquet read/write with compression, Apache Arrow bidirectional conversion, ML.NET DataView integration, CsvHelper-based CSV parsing, lazy data source infrastructure, immutable options with With() builders. Full changelog in CHANGELOG.md.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.PerformanceTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nivara\Nivara.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Streamix" Version="1.2.3" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Onnx\onnx.proto" GrpcServices="None" OutputDir="$(IntermediateOutputPath)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="CsvHelper" Version="34.0.0" />
    <PackageReference Include="Microsoft.ML" Version="6.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="Silk.NET.OpenCL" Version="2.23.0" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageReference Include="Parquet.Net" Version="6.1.1-pre.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

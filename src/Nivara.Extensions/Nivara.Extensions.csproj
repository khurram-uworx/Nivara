<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Nivara.Extensions</PackageId>
    <PackageVersion>1.3.0</PackageVersion>
    <Description>I/O adapters, Parquet, Apache Arrow, ML.NET, and AI integration for Nivara</Description>
    <PackageReleaseNotes>v1.3.0: Parquet and Apache Arrow extended-CLR-domain round-trip (Half, DateOnly, TimeOnly, Guid, TimeSpan, nint/nuint, char, DateTimeOffset) via native field types plus nivara.clrType schema metadata, with Int128/UInt128 throwing documented UnsupportedTypeException; faithful ML.NET ToNivaraFrame reading every primitive DataView type (ConvertToFloat throws for non-numeric values instead of silently returning 0f); immutable JsonOptions/CsvOptions/ParquetWriteOptions with With() builders, CsvTrimOptions and ParquetCompression enums, ParquetWriter honoring Compression/RowGroupSize/WriteMetadata, and ParquetReader reading all row groups; canonical Json/Csv entry points (ReadFrame/ScanFrame/ScanQuery). Existing surface: Parquet read/write with compression, Apache Arrow bidirectional conversion, ML.NET DataView integration, CsvHelper-based CSV parsing, lazy data source infrastructure.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nivara\Nivara.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Streamix" Version="1.2.2" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Nivara.Extensions</PackageId>
    <PackageVersion>2.0.0-preview</PackageVersion>
    <Description>I/O adapters, Parquet, Apache Arrow, ML.NET, and AI integration for Nivara</Description>
    <PackageReleaseNotes>v1.4.0: Public ScanAsQueryFrame lazy streaming factories for CSV/JSON/Parquet; genuinely async chunk reads for CSV and JSON lazy sources (JsonRecordStreamReader for true streaming JSON array parsing); Parquet row-group predicate pushdown and chunk-based streaming via ParquetLazySource; CsvOptions.SchemaInferenceRows renamed to SchemaInferenceRecords; streaming budget tracker and window overlap buffer support; Streamix reactive streaming scenarios (fault-tolerant, windowed analytics, online AutoDiff learning); NivaraFlux bridge (ToFlux, ToFluxRows, ToNivaraFrameAsync); various streaming and execution fixes. Existing surface: Parquet read/write with compression, Apache Arrow bidirectional conversion, ML.NET DataView integration, CsvHelper-based CSV parsing, lazy data source infrastructure, immutable options with With() builders.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nivara.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nivara\Nivara.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Streamix" Version="1.2.3" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.ML" Version="6.0.0-preview.26160.2" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100-preview.7.26381.103" />
    <PackageReference Include="Parquet.Net" Version="6.1.1-pre.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
